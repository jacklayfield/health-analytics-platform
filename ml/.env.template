# Template ML environment file, contains variables used by ml/docker-compose.yml
# Copy this to `ml/.env` and update values for your environment.

WAREHOUSE_DB_URI=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow
MLFLOW_TRACKING_URI=http://mlflow:5000

# Local MLflow metadata database. TODO: Change the password before exposing this stack.
MLFLOW_DB_NAME=mlflow
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=mlflow-dev-only

# Local artifacts are persisted in the mlflow_data Docker volume.
MLFLOW_ARTIFACTS_DESTINATION=/mlflow/artifacts

# After promoting a registered version, point serving at its alias.
# Example after training: models:/health_models_openfda_serious_prediction_random_forest@champion
# MLFLOW_MODEL_URI=

# Optional S3-compatible artifact storage. Keep credentials private and supply
# them only to the MLflow server environment when configuring a real bucket.
# MLFLOW_ARTIFACTS_DESTINATION=s3://health-analytics-mlflow
# MLFLOW_S3_ENDPOINT_URL=https://s3.example.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
